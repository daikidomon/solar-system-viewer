{
  "name": "solar-system-viewer",
  "productName": "太陽系ビューア",
  "version": "1.0.0",
  "description": "実データで動く 3D 太陽系ビューア",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "start:lan": "node server.mjs --host",
    "app": "electron .",
    "data": "python3 tools/build_data.py && node tools/fit-satellites.mjs",
    "verify": "node tools/verify-ephemeris.mjs",
    "test": "node tools/test-interactions.mjs && node tools/test-pwa.mjs",
    "shots": "node tools/shots.mjs",
    "package": "node tools/build-sw.mjs && node tools/make-icon.mjs && node tools/package-app.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^33.4.11",
    "puppeteer-core": "^23.11.1",
    "three": "^0.170.0"
  }
}